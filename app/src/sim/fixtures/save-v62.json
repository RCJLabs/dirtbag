,"grade":7,"paid":false},{"id":"crimp","grade":7,"paid":false}],"shifts0":89,"sessions":0},"year":{"recapped":1,"home":"none"},"life":{"held":0,"told":25,"retired":null},"family":null,"romance":{"who":"sage","stage":2,"since":26,"beatDay":57},"folks":{"calls":2},"record":{"shift":1,"firstsend":1,"flash":1,"onsight":1,"outside":1,"send10":4,"v5":5,"crew":7,"regular":8,"brokedown":14,"train":26,"send50":29,"kit":42,"v10":43,"year":57},"speed":{"pb":null,"runs":0,"day":0},"mode":"rope","soloing":null,"dead":null,"log":[{"day":49,"min":894,"text":"A stamp on your hand, and a nod at the steep end."},{"day":49,"min":902,"text":"Repeat: Lip Service, V5, on go 7."},{"day":49,"min":956,"text":"Gas, $9."},{"day":49,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":49,"min":1060,"text":"Hazel says she once tried to leave the Lot. She got as far as the diner and had pie instead."},{"day":49,"min":1060,"text":"Hazel: \"Granite Gorge. I’ll bring the coffee, you bring the psyche.\""},{"day":49,"min":1060,"text":"Sage: \"Granite Gorge. I’ve already got notes.\""},{"day":49,"min":1060,"text":"Rico: \"Granite Gorge! Yes. I’ll bring snacks. Mostly for me.\""},{"day":49,"min":1060,"text":"Mara: \"Granite Gorge. Don’t be late, and don’t be slow.\""},{"day":50,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":50,"min":430,"text":"Registration and insurance: $70. The week's bills don't care about your card."},{"day":50,"min":430,"text":"Sage is ride-or-die."},{"day":50,"min":430,"text":"You and Mara are partners now: you climb, you belay, nobody keeps score."},{"day":50,"min":430,"text":"Rico is ride-or-die."},{"day":50,"min":450,"text":"Ramen again. It works."},{"day":50,"min":450,"text":"Hazel: “Your shift? Fine. That’s one you owe me.”"},{"day":50,"min":450,"text":"Gas, $1."},{"day":50,"min":818,"text":"Six hours on your feet. +$86."},{"day":50,"min":818,"text":"A walk-in: paid, and that’s all. Signed-up shifts are the ones that count toward a raise."},{"day":50,"min":818,"text":"Gas, $8."},{"day":50,"min":873,"text":"A stamp on your hand, and a nod at the steep end."},{"day":50,"min":881,"text":"Onsight: Fingertip Cavern, V5, on go 1."},{"day":50,"min":889,"text":"Onsight: Heel Hook Grotto, V6, on go 1."},{"day":50,"min":897,"text":"Onsight: The Pocket Pull, V7, on go 1."},{"day":50,"min":905,"text":"Onsight: Lip Service, V7, on go 1."},{"day":50,"min":913,"text":"Onsight: Undercut Engine, V8, on go 1."},{"day":50,"min":913,"text":"Volume Week, done. $12 off the board."},{"day":50,"min":921,"text":"Onsight: Cave Crimps, V9, on go 1."},{"day":50,"min":921,"text":"Gas, $9."},{"day":50,"min":998,"text":"Ramen again. It works."},{"day":50,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":50,"min":1090,"text":"Hazel tells the one about the ranger, the goat and the portaledge. It doesn’t get better. It gets longer."},{"day":51,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":51,"min":430,"text":"You wake up already thinking about the next line."},{"day":51,"min":450,"text":"Ramen again. It works."},{"day":51,"min":450,"text":"Gas, $1."},{"day":51,"min":578,"text":"Belts, hoses, oil, and a look from Dale about the oil."},{"day":51,"min":578,"text":"Gas, $1."},{"day":51,"min":945,"text":"Six hours on your feet. +$86."},{"day":51,"min":945,"text":"Gas, $8."},{"day":51,"min":1000,"text":"A stamp on your hand, and a nod at the steep end."},{"day":51,"min":1008,"text":"Repeat: Fingertip Cavern, V5, on go 2."},{"day":51,"min":1016,"text":"Onsight: The Low Roof, V10, on go 1."},{"day":51,"min":1024,"text":"Onsight: Ceiling Crawl, V11, on go 1."},{"day":51,"min":1024,"text":"Gas, $9."},{"day":51,"min":1101,"text":"Ramen again. It works."},{"day":51,"min":1141,"text":"Sage reads a guidebook by firelight, correcting the grades in pencil."},{"day":52,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":52,"min":450,"text":"Ramen again. It works."},{"day":52,"min":450,"text":"Gas, $1."},{"day":52,"min":818,"text":"Six hours on your feet. +$86."},{"day":52,"min":818,"text":"Make Rent, done. $8 off the board."},{"day":52,"min":828,"text":"The kid at the desk stamps your hand."},{"day":52,"min":836,"text":"Onsight: Pinch Block, V1, on go 1."},{"day":52,"min":844,"text":"Onsight: Slopey Topout, V0, on go 1."},{"day":52,"min":844,"text":"Big Week, done. $18 off the board."},{"day":52,"min":852,"text":"Onsight: Sidepull City, V3, on go 1."},{"day":52,"min":852,"text":"Gas, $1."},{"day":52,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":52,"min":1060,"text":"Hazel says the best day climbing she ever had, she didn’t send anything. She doesn’t explain."},{"day":53,"min":440,"text":"Hazel’s driveway. A real bathroom, and coffee in a real mug in the morning."},{"day":53,"min":440,"text":"Rico pays back the $40, as promised."},{"day":53,"min":460,"text":"Ramen again. It works."},{"day":53,"min":460,"text":"Gas, $1."},{"day":53,"min":468,"text":"You don’t soften it, because softening it would be a lie. They walk off. The rule you kept is the right rule and it cost a person their season, and both of those things are true at once."},{"day":53,"min":828,"text":"Six hours on your feet. +$86."},{"day":53,"min":828,"text":"Promoted: Veteran. That's +$5 a shift."},{"day":53,"min":838,"text":"The kid at the desk stamps your hand."},{"day":53,"min":846,"text":"Onsight: Drop-Knee, V2, on go 1."},{"day":53,"min":846,"text":"Something clicks. You're climbing V7 now."},{"day":53,"min":854,"text":"Onsight: Powerband, V4, on go 1."},{"day":53,"min":862,"text":"Onsight: Sit-Start Special, V5, on go 1."},{"day":53,"min":862,"text":"Gas, $1."},{"day":53,"min":894,"text":"Ramen again. It works."},{"day":53,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":53,"min":1060,"text":"Hazel talks about rope like other people talk about dogs. She’s had seven. She remembers them all."},{"day":54,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":54,"min":450,"text":"Ramen again. It works."},{"day":54,"min":450,"text":"Gas, $1."},{"day":54,"min":829,"text":"Six hours on your feet. +$96."},{"day":54,"min":829,"text":"Gas, $1."},{"day":54,"min":849,"text":"A wristband, and a look that says the comp wall is not for warming up on."},{"day":54,"min":857,"text":"Onsight: Micro Edges, V7, on go 1."},{"day":54,"min":865,"text":"Onsight: Chips, V8, on go 1."},{"day":54,"min":873,"text":"Onsight: Big Volumes, V9, on go 1."},{"day":54,"min":881,"text":"Onsight: Double Clutch, V10, on go 1."},{"day":54,"min":889,"text":"Onsight: Compression Box, V11, on go 1."},{"day":54,"min":889,"text":"Gas, $2."},{"day":54,"min":931,"text":"Ramen again. It works."},{"day":54,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":54,"min":1090,"text":"Hazel pokes the fire and says it’s the best thing she’s done all day. It might be."},{"day":55,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":55,"min":430,"text":"A missed call from home. It’ll keep till you call back."},{"day":55,"min":450,"text":"Ramen again. It works."},{"day":55,"min":450,"text":"Gas, $1."},{"day":55,"min":818,"text":"Six hours on your feet. +$96."},{"day":55,"min":818,"text":"Gas, $1."},{"day":55,"min":946,"text":"One part worth keeping from the free pile. 1 in the van."},{"day":55,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":55,"min":1020,"text":"You text him. He replies with one word and a thumbs up, which is a lot, for him."},{"day":55,"min":1060,"text":"Sage says the hardest move on any route is the first one you decide not to try."},{"day":56,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":56,"min":450,"text":"Ramen again. It works."},{"day":56,"min":450,"text":"Pads, water jugs and a guidebook, $400. Moonstone Boulders is on your map for good."},{"day":56,"min":450,"text":"Gas, $1."},{"day":56,"min":638,"text":"Three hours of oat milk. +$48."},{"day":56,"min":638,"text":"Gas, $30. The van starts on the second try."},{"day":56,"min":638,"text":"Permit, $20. The ranger doesn't look up."},{"day":56,"min":863,"text":"The Ghost Town. A silver-boom town the mountain outlived. Sagging timber, a leaning church, and wind through the empty doorways."},{"day":56,"min":873,"text":"Onsight: Tall Arête, V6, on go 1."},{"day":56,"min":873,"text":"Boulders the size of houses, and you topped one out. The drive home is shorter than the drive out. It always is."},{"day":56,"min":873,"text":"Sent. You did not whoop. You sat at the bottom for a while and let your hands stop shaking. +1 technique."},{"day":56,"min":873,"text":"The local who watched you all season walks over after the send, says nothing for a long while, then tells you what the line is really called: the name that never made it into a guidebook. Then they go back to their own project, and you understand you have been let in on something."},{"day":56,"min":873,"text":"A guidebook author pays $120 for the beta and the photos of the project."},{"day":56,"min":873,"text":"Two hours, six bags, no climbing, and you drive home with your hands smelling of somebody else’s lunch. Nobody sees you do it, except somebody always does, and by the weekend three other people are doing it too."},{"day":56,"min":883,"text":"Onsight: Moonstone Mantel, V7, on go 1."},{"day":56,"min":893,"text":"That's no V9. It's soft, and you're not complaining."},{"day":56,"min":893,"text":"Sun's on this line now. Everything feels greasy."},{"day":56,"min":893,"text":"Onsight: Hueco Pockets, V9, on go 1."},{"day":56,"min":903,"text":"Onsight: The Egg, V8, on go 1."},{"day":56,"min":913,"text":"Onsight: Lunar Roof, V11, on go 1."},{"day":56,"min":913,"text":"Gas, $30. The van starts on the second try."},{"day":56,"min":1113,"text":"Ramen again. It works."},{"day":56,"min":1183,"text":"Hazel says the valley gets smaller every year and the climbing gets bigger. Both are true."},{"day":56,"min":1183,"text":"Hazel: \"Granite Gorge. I’ll bring the coffee, you bring the psyche.\""},{"day":56,"min":1183,"text":"Sage: \"Granite Gorge. I’ve already got notes.\""},{"day":56,"min":1183,"text":"Rico: \"Granite Gorge! Yes. I’ll bring snacks. Mostly for me.\""},{"day":56,"min":1183,"text":"Mara: \"Granite Gorge. Don’t be late, and don’t be slow.\""},{"day":57,"min":440,"text":"Hazel’s driveway. A real bathroom, and coffee in a real mug in the morning."},{"day":57,"min":440,"text":"Registration and insurance: $70. The week's bills don't care about your card."},{"day":57,"min":460,"text":"Ramen again. It works."},{"day":57,"min":460,"text":"Gas, $1."},{"day":57,"min":479,"text":"Fresh rubber. For a day they'll feel like someone else's."},{"day":57,"min":484,"text":"You crush half of it into the bag before you reach the door."},{"day":57,"min":484,"text":"Gas, $22. The van starts on the second try."},{"day":57,"min":733,"text":"You and Sage top out the testpiece together. Partners for good. +6 technique."},{"day":57,"min":733,"text":"You apologise properly. Sage makes you mean it, then lets it go."},{"day":57,"min":733,"text":"You tell Rico something came up. Rico says it’s fine, in the voice that means it isn’t, and isn’t around for a week. By the weekend Sage and Rico aren’t speaking, and it’s about you, and everyone knows it."},{"day":57,"min":753,"text":"Sage climbs Serenity Crack. At the flare: layback. New beta: layback off the flake."},{"day":57,"min":933,"text":"You belay Mara all day. She doesn’t send. On the walk out she tells you it was a good day. +2 head."},{"day":57,"min":933,"text":"Mara: “The rack. Once. Don’t make it a habit.”"},{"day":57,"min":943,"text":"Hazel goes first and comes off at the roof, swearing. You were watching the feet: toe-hook the lip."},{"day":57,"min":953,"text":"Sage reads it for ten minutes, climbs slow to the long finish, and steps off. “Shake out in the crack. Try it.”"},{"day":57,"min":963,"text":"Mara has a go. Nothing you didn’t already know, but it’s good to watch."},{"day":57,"min":973,"text":"Mara is ride-or-die."},{"day":57,"min":973,"text":"Repeat: Granite Slab, V5, on go 3."},{"day":57,"min":998,"text":"Flash: Power Endurance, 5.13a, on go 1."},{"day":57,"min":998,"text":"Hazel says the clipping was ugly and the climbing was lovely."},{"day":57,"min":998,"text":"Hazel goes straight after you and gets it too, complaining the whole way."},{"day":57,"min":998,"text":"Sage watches your beta once more, then climbs it exactly the way you did."},{"day":57,"min":998,"text":"Mara gets on before you’ve finished celebrating and sends it without a word."},{"day":57,"min":998,"text":"The send train goes: Send City Lifers, one after another up Power Endurance."},{"day":57,"min":1023,"text":"Onsight: Gorge Intro, 5.12b, on go 1."},{"day":57,"min":1023,"text":"Sage says nothing at all, which from her is a standing ovation."},{"day":57,"min":1023,"text":"Gas, $22. The van starts on the second try."},{"day":57,"min":1213,"text":"Hazel says nothing for a long time, then: \"Good day.\" It was."},{"day":57,"min":1213,"text":"The crew project: Moonlight Arête, 5.13c. Everyone has an opinion about it already."},{"day":58,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":58,"min":430,"text":"You wake up already thinking about the next line."},{"day":58,"min":450,"text":"Ramen again. It works."},{"day":58,"min":450,"text":"Gas, $1."},{"day":58,"min":638,"text":"Three hours of oat milk. +$48."},{"day":58,"min":638,"text":"Gas, $1."},{"day":58,"min":658,"text":"A wristband, and a look that says the comp wall is not for warming up on."},{"day":58,"min":666,"text":"Onsight: The Hug, V7, on go 1."},{"day":58,"min":674,"text":"Onsight: Run and Jump, V8, on go 1."},{"day":58,"min":682,"text":"Onsight: Big Volumes, V9, on go 1."},{"day":58,"min":682,"text":"Gas, $2."},{"day":58,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":58,"min":1060,"text":"Hazel says the valley gets smaller every year and the climbing gets bigger. Both are true."},{"day":59,"min":430,"text":"Van spot, $18. Morning comes anyway."},{"day":59,"min":450,"text":"Ramen again. It works."},{"day":59,"min":450,"text":"Gas, $1."},{"day":59,"min":649,"text":"Three hours of oat milk. +$48."},{"day":59,"min":649,"text":"Gas, $32. The van starts on the second try."},{"day":59,"min":874,"text":"The Fire Lookout. An old ranger tower on the high point for miles. Climb the stairs and the whole range opens under you."},{"day":59,"min":874,"text":"Mara: “The rack. Once. Don’t make it a habit.”"},{"day":59,"min":884,"text":"Onsight: Desert Varnish, V7, on go 1."},{"day":59,"min":894,"text":"Sun's on this line now. Everything feels greasy."},{"day":59,"min":894,"text":"Onsight: Sandstone Crimps, V8, on go 1."},{"day":59,"min":904,"text":"Onsight: Powerhouse, V10, on go 1."},{"day":59,"min":904,"text":"Gas, $32. The van starts on the second try."},{"day":59,"min":1104,"text":"Ramen again. It works."},{"day":59,"min":1174,"text":"Hazel hums something tuneless and lets the silence do the rest."},{"day":60,"min":430,"text":"Van spot, $18. You're $17 in the hole."},{"day":60,"min":430,"text":"Word from the gym: Dex blew a pulley. Out for 3 weeks, they're saying. The benchmark just stopped moving."},{"day":60,"min":450,"text":"Ramen again. It works."},{"day":60,"min":450,"text":"Gas, $1."},{"day":60,"min":818,"text":"Six hours on your feet. +$96."},{"day":60,"min":818,"text":"Gas, $1."},{"day":60,"min":838,"text":"A wristband, and a look that says the comp wall is not for warming up on."},{"day":60,"min":846,"text":"Repeat: The Hug, V7, on go 2."},{"day":60,"min":854,"text":"Sliding off, your hand drags over a seam. New beta: crimp the seam."},{"day":60,"min":872,"text":"Redpoint: The Pinch Slab, V10, on go 2."},{"day":60,"min":898,"text":"Second time off. There's heel rubber right by your hip. New beta: heel hook."},{"day":60,"min":926,"text":"Gas, $2."},{"day":60,"min":968,"text":"Ramen again. It works."},{"day":60,"min":1020,"text":"You read the same page until it's too dark to read."},{"day":60,"min":1090,"text":"Hazel watches the sparks go up and counts them, out loud, till she loses track at eleven."},{"day":61,"min":440,"text":"Hazel’s driveway. A real bathroom, and coffee in a real mug in the morning."}]}}